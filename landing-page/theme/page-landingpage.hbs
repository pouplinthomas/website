              <option>Classic products / samples</option>
              <option>Contract extraction</option>
              <option>R&amp;D partnership</option>
              <option>Press / media</option>
              <option>Other</option>
            </select>
          </div>
          <div class="ls-form__field ls-form__field--full">
            <label class="ls-form__label" for="ls-msg">Your project</label>
            <textarea id="ls-msg" name="message" class="ls-form__textarea" placeholder="Materials of interest, estimated volumes, timeline…"></textarea>
          </div>
          <button type="submit" class="ls-btn ls-form__submit" id="ls-form-submit-btn">
            Send request <span class="ls-btn__arrow">→</span>
          </button>
          <p id="ls-form-status" style="grid-column: 1 / -1; margin-top: 16px; font-size: 14.4px;"></p>
        </form>

        <script>
        (function() {
          const form = document.getElementById('ls-contact-form');
          const status = document.getElementById('ls-form-status');
          const btn = document.getElementById('ls-form-submit-btn');

          form.addEventListener('submit', function(e) {
            e.preventDefault();
            btn.disabled = true;
            btn.style.opacity = '0.6';
            status.textContent = 'Sending…';
            status.style.color = 'rgba(245,240,230,0.8)';

            fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { 'Accept': 'application/json' }
            })
            .then(function(response) {
              if (response.ok) {
                status.textContent = "Thank you. Your message has been sent. We'll reply within two business days.";
                status.style.color = '#c9a97a';
                if (typeof gtag === 'function') {
                  gtag('event', 'generate_lead', {
                    form_id: 'ls-contact-form',
                    page_location: window.location.href
                  });
                }
                form.reset();
              } else {
                status.textContent = "Something went wrong. Please email us directly at info@losiam.com.";
                status.style.color = '#e08a6a';
              }
            })
            .catch(function() {
              status.textContent = "Something went wrong. Please email us directly at info@losiam.com.";
              status.style.color = '#e08a6a';
            })
            .finally(function() {
              btn.disabled = false;
              btn.style.opacity = '1';
            });
          });
        })();
        </script>
      </div>
    </div>
