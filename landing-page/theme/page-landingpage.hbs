<!-- =========================================================
     BANDEAU DÉFILANT — seul contenu encore piloté en JS, car ce
     n'est pas de l'éditorial (pas besoin d'en faire des posts Ghost).
     ========================================================= -->
<script>
(function () {
  const MARQUEE_ITEMS = [
    'Upcycled Teak CO2',
    'Saraphi Flowers',
    'Fresh Pandan leaves',
    'Flue-cured Thai Tobacco',
    'Jungle Pepper (Fresh & Dry)',
    'Lotus Flowers',
    'Thai Ya Dong',
    'Upcycled Mandarin peels',
    'Fermented Assam Tea Leaves',
  ];

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  function renderMarquee(items) {
    const track = document.getElementById('ls-marquee-track');
    if (!track) return;
    const doubled = items.concat(items);
    track.innerHTML = doubled
      .map(function (label) {
        return '<span class="ls-marquee__item">' + escapeHtml(label) + '</span>';
      })
      .join('');
  }

  renderMarquee(MARQUEE_ITEMS);
})();
</script>
