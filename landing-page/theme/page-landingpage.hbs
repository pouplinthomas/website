</style>

<main class="gh-main">
<div class="losiam-home">

  <!-- ============= HERO — PLEINE LARGEUR ============= -->
  <!--
    PHOTO DU HERO :
    Pour remplacer, upload ta photo dans n'importe quel post Ghost
    (brouillon), copie son URL ("Copy image URL"), colle-la dans le
    "src" de l'<img> ci-dessous, puis supprime le brouillon.
  -->
  <section style="
    min-height: 100vh;
    background: #344028;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
