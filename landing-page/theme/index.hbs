{{!< default}}

{{#contentFor "title"}}{{#match pagination.pages ">" 1}}Latest (Page {{pagination.page}}) — {{@site.title}}{{else}}Latest — {{@site.title}}{{/match}}{{/contentFor}}

<main class="gh-main gh-outer">
    <div class="gh-inner">

        <section class="gh-pagehead">
            <h1 class="gh-pagehead-title">Latest</h1>
        </section>

        <div class="gh-topic gh-topic-grid">
            <div class="gh-topic-content gh-feed">
                                {{#foreach posts}}
                    {{> "loop-grid" has_large_post=false}}
                {{/foreach}}
            </div>
        </div>

    </div>
</main>